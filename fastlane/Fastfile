default_platform(:ios)

SCREENSHOT_DEVICES = [
  "iPhone 17 Pro Max",
  "iPhone 17 Pro",
  "iPhone 16e"
]

BUNDLE_ID = "com.rohanthomas.PokerStats"

# Build number: ci_scripts/build_number.sh (UTC YYYYMMDDHHMM), passed as the
# CURRENT_PROJECT_VERSION build setting so the app and the widget extension
# get the same value. project.yml's CURRENT_PROJECT_VERSION is only the local
# default. No App Store Connect API call is needed.
def build_with_new_build_number
  build_number = sh("cd .. && ci_scripts/build_number.sh").strip
  UI.message("Build number: #{build_number}")
  # Automatic signing via the App Store Connect API key (when present) plus
  # -allowProvisioningUpdates. Covers the app, the PokerStatsWidgets
  # extension (Live Activity / widget), and the shared App Group
  # group.com.rohanthomas.PokerStats. Team ID comes from project.yml.
  FileUtils.mkdir_p(File.expand_path("../build", __dir__))
  build_app(
    scheme: "PokerStats",
    export_method: "app-store",
    output_directory: File.expand_path("../build", __dir__),
    xcargs: "CURRENT_PROJECT_VERSION=#{build_number} -allowProvisioningUpdates"
  )
  app = File.join(lane_context[SharedValues::XCODEBUILD_ARCHIVE], "Products/Applications/PokerStats.app")
  sh("cd .. && ci_scripts/check_build_numbers.sh '#{app}' '#{build_number}'")
end

# Auth for upload_to_testflight / upload_to_app_store and for xcodebuild
# provisioning updates. Key material comes from env (GitHub secrets in CI).
# Never UI.message or puts the key body.
def ensure_asc_api_key!
  key_id = ENV["ASC_KEY_ID"].to_s
  issuer_id = ENV["ASC_ISSUER_ID"].to_s
  key_path = ENV["ASC_KEY_PATH"].to_s
  key_content = ENV["ASC_PRIVATE_KEY"].to_s

  if key_id.empty? || issuer_id.empty? || (key_path.empty? && key_content.empty?)
    UI.user_error!("ASC_KEY_ID, ASC_ISSUER_ID, and ASC_PRIVATE_KEY (or ASC_KEY_PATH) are required for signing/upload.")
  end

  args = {
    key_id: key_id,
    issuer_id: issuer_id,
    duration: 1200,
    in_house: false
  }
  if !key_path.empty? && File.exist?(key_path)
    args[:key_filepath] = key_path
  else
    args[:key_content] = key_content
    args[:is_key_content_base64] = false
  end
  app_store_connect_api_key(**args)
end

def dry_run?(options = {})
  return true if options[:dry_run]
  %w[1 true yes].include?(ENV["DRY_RUN"].to_s.downcase)
end

def what_to_test(options = {})
  notes_file = options[:notes_file].to_s
  if !notes_file.empty? && File.exist?(notes_file)
    return File.read(notes_file).strip
  end
  text = ENV["WHAT_TO_TEST"].to_s.strip
  return text unless text.empty?
  path = File.expand_path("metadata/en-US/release_notes.txt", __dir__)
  return File.read(path).strip if File.exist?(path)
  "PokerStats build"
end

platform :ios do
  desc "Generate App Store screenshots"
  lane :screenshots do
    sh("cd .. && xcodegen generate")

    output_dir = File.expand_path("../fastlane/screenshots")
    FileUtils.mkdir_p(output_dir)

    # Build app and tests once (using first device)
    UI.message("Building app and tests...")
    sh("cd .. && xcodebuild -scheme PokerStats -project PokerStats.xcodeproj " \
       "-destination 'platform=iOS Simulator,name=iPhone 17 Pro Max' " \
       "build-for-testing 2>&1 | tail -5")

    SCREENSHOT_DEVICES.each do |device|
      UI.message("=== Capturing on #{device} ===")

      # Boot simulator
      sh("xcrun simctl boot '#{device}' 2>/dev/null || true")
      sleep(2)

      # Clean app data so seeding starts fresh
      sh("xcrun simctl terminate '#{device}' #{BUNDLE_ID} 2>/dev/null || true")
      sh("xcrun simctl uninstall '#{device}' #{BUNDLE_ID} 2>/dev/null || true")

      # Override status bar for clean screenshots
      sh("xcrun simctl status_bar '#{device}' override " \
         "--time 09:41 --dataNetwork wifi --wifiMode active --wifiBars 3 " \
         "--cellularMode active --operatorName '' --cellularBars 4 " \
         "--batteryState charged --batteryLevel 100 2>/dev/null || true")

      # Run UI tests — the test launches the app with --seed-screenshot-data,
      # which seeds data on first launch, then captures all screenshots
      sh("cd .. && xcodebuild -scheme PokerStats -project PokerStats.xcodeproj " \
         "-destination 'platform=iOS Simulator,name=#{device}' " \
         "-only-testing:PokerStatsUITests/ScreenshotTests/testCaptureAppStoreScreenshots " \
         "test 2>&1 | tail -5")

      # Copy screenshots from Fastlane cache to output
      cache_dir = File.expand_path("~/Library/Caches/tools.fastlane/screenshots")
      if File.directory?(cache_dir)
        Dir.glob("#{cache_dir}/*.png").each do |file|
          FileUtils.cp(file, output_dir)
        end
      end

      sh("xcrun simctl shutdown '#{device}' 2>/dev/null || true")
    end

    # Resize screenshots to App Store Connect required dimensions
    UI.message("Resizing screenshots to App Store dimensions...")
    appstore_dir = File.join(output_dir, "appstore")
    FileUtils.mkdir_p(appstore_dir)

    # App Store 6.5" display: 1284x2778 (portrait) or 1242x2688
    TARGET_WIDTH = 1284
    TARGET_HEIGHT = 2778

    Dir.glob("#{output_dir}/*.png").each do |file|
      basename = File.basename(file)
      dest = File.join(appstore_dir, basename)
      FileUtils.cp(file, dest)
      sh("sips -z #{TARGET_HEIGHT} #{TARGET_WIDTH} '#{dest}' --out '#{dest}' 2>/dev/null")
    end

    UI.success("Original screenshots: #{output_dir}")
    UI.success("App Store sized (#{TARGET_WIDTH}x#{TARGET_HEIGHT}): #{appstore_dir}")
  end

  desc "Upload screenshots to App Store Connect"
  lane :upload_screenshots do
    deliver(
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true
    )
  end

  desc "Upload to TestFlight (dry_run:true builds and signs only)"
  lane :beta do |options|
    ensure_asc_api_key!
    sh("cd .. && xcodegen generate")
    build_with_new_build_number
    if dry_run?(options)
      UI.success("dry_run: built and signed; skipped upload_to_testflight")
    else
      upload_to_testflight(
        changelog: what_to_test(options),
        distribute_external: false,
        skip_waiting_for_build_processing: true
      )
    end
  end

  # Uploads the build and metadata only. Submitting for App Review is done
  # manually by the owner in App Store Connect, every time. Never set
  # submit_for_review to true. The ios-release workflow may call this lane
  # only on an ios-v* tag (or workflow_dispatch path=appstore); ordinary CI
  # must never call it.
  desc "Upload to App Store Connect (no review submission; the owner submits manually)"
  lane :release do |options|
    ensure_asc_api_key!
    sh("cd .. && xcodegen generate")
    build_with_new_build_number
    if dry_run?(options)
      UI.success("dry_run: built and signed; skipped upload_to_app_store")
    else
      upload_to_app_store(
        submit_for_review: false,
        automatic_release: false,
        precheck_include_in_app_purchases: false,
        force: true
      )
    end
  end
end
