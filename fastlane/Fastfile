require_relative "asc_key"

default_platform(:ios)

SCREENSHOT_DEVICES = [
  "iPhone 17 Pro Max",
  "iPhone 17 Pro",
  "iPhone 16e"
]

BUNDLE_ID = "com.rohanthomas.PokerStats"

# Build number: ci_scripts/build_number.sh (UTC YYYYMMDDHHMMSS), passed as the
# CURRENT_PROJECT_VERSION build setting so the app and its extensions get the
# same value. project.yml's CURRENT_PROJECT_VERSION is only the local
# default. No App Store Connect API call is needed. Build numbers are
# timestamps from now on and can't go back to a smaller counter: every later
# build of a version must be higher than its last upload, so any other upload
# path (Xcode Cloud, #66) must use the same script or start above the latest
# timestamp build.
def build_with_new_build_number(key)
  build_number = sh("cd .. && ci_scripts/build_number.sh").strip
  UI.message("Build number: #{build_number}")
  # Cloud-managed signing: xcodebuild gets the App Store Connect API key for
  # both archive and export, since app_store_connect_api_key only covers
  # fastlane's own uploads. Covers the app, the PokerStatsWidgets extension
  # (Live Activity / widget), and the shared App Group
  # group.com.rohanthomas.PokerStats. Team ID comes from project.yml.
  # manageAppVersionAndBuildNumber: false stops the export from rewriting
  # CFBundleVersion, so the IPA carries the build number checked below.
  # disable_package_automatic_updates passes -disableAutomaticPackageResolution
  # (as ci.yml does), so the package resolve and the archive use the committed
  # Package.resolved and fail if it is missing or out of date. The lanes check
  # that file against the commit before this runs (generate_project.sh).
  signing = AscKey.xcodebuild_flags(key)
  FileUtils.mkdir_p(File.expand_path("../build", __dir__))
  build_app(
    scheme: "PokerStats",
    export_method: "app-store-connect",
    export_options: { manageAppVersionAndBuildNumber: false },
    output_directory: File.expand_path("../build", __dir__),
    xcargs: "CURRENT_PROJECT_VERSION=#{build_number} #{signing}",
    export_xcargs: signing,
    disable_package_automatic_updates: true
  )
  app = File.join(lane_context[SharedValues::XCODEBUILD_ARCHIVE], "Products/Applications/PokerStats.app")
  sh("cd .. && ci_scripts/check_build_numbers.sh #{app.shellescape} #{build_number.shellescape}")
end

# Loads the key for fastlane's uploads and returns it for xcodebuild.
def ensure_asc_api_key!
  key = AscKey.load
  app_store_connect_api_key(
    key_id: key[:id],
    issuer_id: key[:issuer],
    key_filepath: key[:path],
    duration: 1200,
    in_house: false
  )
  key
rescue ArgumentError => e
  UI.user_error!(e.message)
end

def dry_run?(options = {})
  return true if options[:dry_run]
  %w[1 true yes].include?(ENV["DRY_RUN"].to_s.downcase)
end

def what_to_test(options = {})
  notes_file = options[:notes_file].to_s
  if !notes_file.empty? && File.exist?(notes_file)
    return File.read(notes_file).strip
  end
  text = ENV["WHAT_TO_TEST"].to_s.strip
  return text unless text.empty?
  path = File.expand_path("metadata/en-US/release_notes.txt", __dir__)
  return File.read(path).strip if File.exist?(path)
  "PokerStats build"
end

platform :ios do
  desc "Generate App Store screenshots"
  lane :screenshots do
    sh("cd .. && xcodegen generate")

    output_dir = File.expand_path("../fastlane/screenshots")
    FileUtils.mkdir_p(output_dir)

    # Build app and tests once (using first device)
    UI.message("Building app and tests...")
    sh("cd .. && xcodebuild -scheme PokerStats -project PokerStats.xcodeproj " \
       "-destination 'platform=iOS Simulator,name=iPhone 17 Pro Max' " \
       "build-for-testing 2>&1 | tail -5")

    SCREENSHOT_DEVICES.each do |device|
      UI.message("=== Capturing on #{device} ===")

      # Boot simulator
      sh("xcrun simctl boot '#{device}' 2>/dev/null || true")
      sleep(2)

      # Clean app data so seeding starts fresh
      sh("xcrun simctl terminate '#{device}' #{BUNDLE_ID} 2>/dev/null || true")
      sh("xcrun simctl uninstall '#{device}' #{BUNDLE_ID} 2>/dev/null || true")

      # Override status bar for clean screenshots
      sh("xcrun simctl status_bar '#{device}' override " \
         "--time 09:41 --dataNetwork wifi --wifiMode active --wifiBars 3 " \
         "--cellularMode active --operatorName '' --cellularBars 4 " \
         "--batteryState charged --batteryLevel 100 2>/dev/null || true")

      # Run UI tests — the test launches the app with --seed-screenshot-data,
      # which seeds data on first launch, then captures all screenshots
      sh("cd .. && xcodebuild -scheme PokerStats -project PokerStats.xcodeproj " \
         "-destination 'platform=iOS Simulator,name=#{device}' " \
         "-only-testing:PokerStatsUITests/ScreenshotTests/testCaptureAppStoreScreenshots " \
         "test 2>&1 | tail -5")

      # Copy screenshots from Fastlane cache to output
      cache_dir = File.expand_path("~/Library/Caches/tools.fastlane/screenshots")
      if File.directory?(cache_dir)
        Dir.glob("#{cache_dir}/*.png").each do |file|
          FileUtils.cp(file, output_dir)
        end
      end

      sh("xcrun simctl shutdown '#{device}' 2>/dev/null || true")
    end

    # Resize screenshots to App Store Connect required dimensions
    UI.message("Resizing screenshots to App Store dimensions...")
    appstore_dir = File.join(output_dir, "appstore")
    FileUtils.mkdir_p(appstore_dir)

    # App Store 6.5" display: 1284x2778 (portrait) or 1242x2688
    TARGET_WIDTH = 1284
    TARGET_HEIGHT = 2778

    Dir.glob("#{output_dir}/*.png").each do |file|
      basename = File.basename(file)
      dest = File.join(appstore_dir, basename)
      FileUtils.cp(file, dest)
      sh("sips -z #{TARGET_HEIGHT} #{TARGET_WIDTH} '#{dest}' --out '#{dest}' 2>/dev/null")
    end

    UI.success("Original screenshots: #{output_dir}")
    UI.success("App Store sized (#{TARGET_WIDTH}x#{TARGET_HEIGHT}): #{appstore_dir}")
  end

  desc "Upload screenshots to App Store Connect"
  lane :upload_screenshots do
    deliver(
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true
    )
  end

  desc "Upload to TestFlight (dry_run:true builds and signs only)"
  lane :beta do |options|
    key = ensure_asc_api_key!
    sh("cd .. && ci_scripts/generate_project.sh")
    build_with_new_build_number(key)
    if dry_run?(options)
      UI.success("dry_run: built and signed; skipped upload_to_testflight")
    else
      upload_to_testflight(
        changelog: what_to_test(options),
        distribute_external: false,
        skip_waiting_for_build_processing: true
      )
    end
  end

  # Uploads the build only. Submitting for App Review is done manually by the
  # owner in App Store Connect, every time. Never set submit_for_review to
  # true. Runs only from the appstore job in .github/workflows/ios-release.yml,
  # which is gated by the app-store environment; never from ci.yml or any
  # other job. Metadata and screenshots are skipped until the metadata fixes
  # in #53 land.
  desc "Upload to App Store Connect (no review submission; the owner submits manually)"
  lane :release do |options|
    key = ensure_asc_api_key!
    sh("cd .. && ci_scripts/generate_project.sh")
    build_with_new_build_number(key)
    if dry_run?(options)
      UI.success("dry_run: built and signed; skipped upload_to_app_store")
    else
      upload_to_app_store(
        submit_for_review: false,
        automatic_release: false,
        skip_metadata: true,
        skip_screenshots: true,
        precheck_include_in_app_purchases: false
      )
    end
  end
end
