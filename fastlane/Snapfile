# Snapfile — Fastlane screenshot automation for PokerStats
# Run with: fastlane snapshot

# Native 6.9-inch size (1320x2868). Other sizes are not captured.
devices([
  "iPhone 17 Pro Max"
])

# Languages (add more as needed)
languages([
  "en-US"
])

# ios_version is omitted. GitHub's macos-26 image ships iOS simulator
# runtimes 26.2, 26.4.1, and 26.5, not 26.3.1. The screenshots lane picks
# the newest iOS 26 iPhone 17 Pro Max, and the workflow prints
# `xcrun simctl list runtimes` and devices so the choice is visible.

# Xcode scheme and test plan
scheme("PokerStats")

# Output directory (deliver looks for language folders under this path)
output_directory("./fastlane/screenshots")

# Clean previous screenshots
clear_previous_screenshots(true)

# Stop after first failure (faster iteration)
stop_after_first_error(true)

# Dark mode (app forces dark mode, but ensure simulator matches)
dark_mode(true)

# Override status bar for clean screenshots
override_status_bar(true)

# Disable concurrent simulators for stability
concurrent_simulators(false)
