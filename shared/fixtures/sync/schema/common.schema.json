{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rohanthomas1202/PokerStats/shared/fixtures/sync/schema/common.schema.json",
  "title": "Sync column types shared by pushes and pulls",
  "description": "Docs: docs/design/1.1-sync.md sections 2, 4.1 and 9.4. Formats are patterns, since format is annotation-only in draft 2020-12.",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "nullable_uuid": {
      "anyOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "description": "ISO 8601 with an explicit offset. Clients send UTC with fractional seconds (9.4); PostgREST returns +00:00.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullable_timestamp": {
      "anyOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "money": {
      "description": "numeric(14,2). Clients round to cents and clamp to this range (9.4).",
      "type": "number",
      "minimum": -999999999999.99,
      "maximum": 999999999999.99
    },
    "short_text": {
      "type": "string",
      "maxLength": 200
    },
    "notes": {
      "type": "string",
      "maxLength": 10000
    },
    "mental_level": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 5
    },
    "data_enum": {
      "description": "Enum columns are text with no check (2.4). Clients decode unknown values with fallbacks (9.5).",
      "type": "string"
    },
    "poker_sessions_columns": {
      "description": "Client columns of poker_sessions (2.4). The only keys allowed in a push's fields.",
      "type": "object",
      "properties": {
        "start_time": {
          "$ref": "#/$defs/timestamp"
        },
        "end_time": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "location": {
          "$ref": "#/$defs/short_text"
        },
        "stakes": {
          "$ref": "#/$defs/short_text"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "game_type": {
          "$ref": "#/$defs/data_enum"
        },
        "status": {
          "$ref": "#/$defs/data_enum"
        },
        "buy_in": {
          "$ref": "#/$defs/money"
        },
        "rebuys": {
          "$ref": "#/$defs/money"
        },
        "add_ons": {
          "$ref": "#/$defs/money"
        },
        "cash_out": {
          "$ref": "#/$defs/money"
        },
        "tip_rake": {
          "$ref": "#/$defs/money"
        },
        "tilt_level": {
          "$ref": "#/$defs/mental_level"
        },
        "energy_level": {
          "$ref": "#/$defs/mental_level"
        },
        "focus_level": {
          "$ref": "#/$defs/mental_level"
        },
        "table_config": {
          "description": "A JSON object, never a string (9.4). The 16 KB limit is server-enforced.",
          "type": [
            "object",
            "null"
          ]
        },
        "logging_device_id": {
          "$ref": "#/$defs/nullable_uuid"
        }
      }
    },
    "hands_columns": {
      "description": "Client columns of hands (2.5).",
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/uuid"
        },
        "hand_number": {
          "description": "Create-only (2.5, 3.2).",
          "type": "integer"
        },
        "played_at": {
          "$ref": "#/$defs/timestamp"
        },
        "preflop_action": {
          "$ref": "#/$defs/data_enum"
        },
        "faced_3bet": {
          "type": "boolean"
        },
        "three_bet_response": {
          "type": [
            "string",
            "null"
          ]
        },
        "postflop_result": {
          "type": [
            "string",
            "null"
          ]
        },
        "did_cbet": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "position": {
          "$ref": "#/$defs/data_enum"
        }
      }
    },
    "user_settings_columns": {
      "description": "Client columns of user_settings (2.6).",
      "type": "object",
      "properties": {
        "default_game_type": {
          "$ref": "#/$defs/data_enum"
        },
        "default_stakes": {
          "$ref": "#/$defs/short_text"
        },
        "default_buy_in": {
          "$ref": "#/$defs/money"
        },
        "currency": {
          "type": "string",
          "maxLength": 8
        }
      }
    },
    "sync_columns": {
      "description": "Sync columns every synced table has (2). Set by the server, never sent in fields.",
      "type": "object",
      "properties": {
        "user_id": {
          "$ref": "#/$defs/uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "server_updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "deleted_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "purged_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "updated_by_device": {
          "$ref": "#/$defs/nullable_uuid"
        }
      }
    }
  }
}
