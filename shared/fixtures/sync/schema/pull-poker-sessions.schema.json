{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rohanthomas1202/PokerStats/shared/fixtures/sync/schema/pull-poker-sessions.schema.json",
  "title": "Pulled page of poker_sessions",
  "description": "PostgREST select * on poker_sessions, one page (docs/design/1.1-sync.md 2.4, 4.3). Open: clients ignore unknown columns.",
  "type": "array",
  "maxItems": 1000,
  "items": {
    "$ref": "#/$defs/row"
  },
  "$defs": {
    "row": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/poker_sessions_columns"
        },
        {
          "$ref": "common.schema.json#/$defs/sync_columns"
        }
      ],
      "required": [
        "id",
        "start_time",
        "end_time",
        "location",
        "stakes",
        "notes",
        "game_type",
        "status",
        "buy_in",
        "rebuys",
        "add_ons",
        "cash_out",
        "tip_rake",
        "tilt_level",
        "energy_level",
        "focus_level",
        "table_config",
        "logging_device_id",
        "user_id",
        "revision",
        "server_updated_at",
        "deleted_at",
        "purged_at",
        "updated_by_device"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        }
      }
    }
  }
}
